---
import { ArrowRight, BookOpen, Clock, Tag } from "@lucide/astro";

interface ArticleItem {
  title: string;
  url: string;
  description: string;
  readTime: string;
  tag: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  articles: ArticleItem[];
}

const {
  title = "本专题核心深度实战研报集群（三级长文 Topic Cluster）",
  subtitle = "下辖二级专题所规划的三级万字实操文献（6000~15000字），基于物理探针压测与网络工程验证",
  articles = []
} = Astro.props;
---

<div class="my-14 rounded-2xl border border-dashed border-primary/20 dark:border-primary-light/20 bg-gradient-to-b from-primary/[0.02] to-transparent p-6 sm:p-8">
  <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary dark:bg-primary-light/10 dark:text-primary-light text-xs font-semibold uppercase tracking-wider mb-2">
        <BookOpen class="w-3.5 h-3.5" />
        <span>三级内容集群 · L3 Topic Cluster</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white">
        {title}
      </h3>
      <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mt-1 max-w-2xl">
        {subtitle}
      </p>
    </div>
    <a 
      href="/blog" 
      class="inline-flex items-center gap-1 text-xs font-medium text-primary dark:text-primary-light hover:underline whitespace-nowrap self-start md:self-auto"
    >
      <span>浏览全部 34 篇三级研报</span>
      <ArrowRight class="w-3.5 h-3.5" />
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    {articles.map((art) => (
      <a
        href={art.url}
        class="group relative flex flex-col justify-between p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-bg-secondary-dark hover:border-primary/50 dark:hover:border-primary-light/50 transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 text-left"
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="inline-flex items-center gap-1 text-[11px] font-medium text-primary dark:text-primary-light bg-primary/5 dark:bg-primary/10 px-2 py-0.5 rounded-md border border-primary/10">
                <Tag class="w-3 h-3" />
                二级专题 · {art.tag}
              </span>
              <span class="text-[10px] font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 px-2 py-0.5 rounded-md">
                三级长文
              </span>
            </div>
            <span class="inline-flex items-center gap-1 text-[11px] text-neutral-400 dark:text-neutral-500 shrink-0">
              <Clock class="w-3 h-3" />
              {art.readTime}
            </span>
          </div>

          <h4 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white group-hover:text-primary dark:group-hover:text-primary-light transition-colors line-clamp-2 leading-snug">
            {art.title}
          </h4>

          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-2 line-clamp-2 leading-relaxed">
            {art.description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-between text-xs font-medium text-neutral-600 dark:text-neutral-300 group-hover:text-primary dark:group-hover:text-primary-light">
          <span>阅读三级深度实战长文 (万字解析)</span>
          <ArrowRight class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" />
        </div>
      </a>
    ))}
  </div>
</div>
