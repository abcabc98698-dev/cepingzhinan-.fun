              <th class="p-3.5 font-semibold">资金成本</th>
              <th class="p-3.5 font-semibold">晚高峰体验</th>
              <th class="p-3.5 font-semibold">流媒体 & AI解锁</th>
              <th class="p-3.5 font-semibold">隐私安全等级</th>
              <th class="p-3.5 font-semibold">推荐使用场景</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
            <tr class="hover:bg-primary/5 transition-colors">
