              <td class="p-3.5 text-neutral-500">¥ 0 元</td>
              <td class="p-3.5 text-red-600 font-semibold">极高丢包率 (50%+)，频繁断流</td>
              <td class="p-3.5 text-red-600 font-semibold">基本无法解锁 / IP 被拉黑</td>
              <td class="p-3.5 text-red-600 font-bold">高危 (黑产蜜罐、窃听风险)</td>
              <td class="p-3.5 text-red-600">强烈不建议使用</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 5. 核心深度实战研报集群 (Topic Cluster) -->
    <section data-aos="fade-up-xs">
      <ClusterArticlesGrid articles={freeArticles} />
    </section>

    <!-- 6. FAQ 常见问题 -->
    <section id="clients" class="space-y-6" data-aos="fade-up-xs">
      <h2 class="text-2xl md:text-3xl font-brand text-neutral-800 dark:text-neutral-100">
        免费机场使用常见问题解答 (FAQ)
      </h2>
      <div class="space-y-3">
        {faqs.map((f, i) => (
          <AccordionItem question={f.question} answer={f.answer} index={i} />
        ))}
      </div>
    </section>

    <!-- 7. 内链主线闭环导航 -->
    <section class="border-t border-dashed border-neutral-300 dark:border-neutral-700 pt-8 flex flex-wrap justify-between items-center gap-4 text-xs md:text-sm">
      <span class="text-neutral-500">内链主线导航：</span>
      <div class="flex flex-wrap gap-2">
        <a href="/recommend" class="hover:text-primary">机场推荐</a>
        <span class="text-neutral-400">→</span>
        <a href="/free" class="font-bold text-primary">免费机场</a>
