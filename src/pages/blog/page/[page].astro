---
import { getCollection } from "astro:content";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import { siteConfig } from "@/config/site.js";
import Layout from "@/layouts/Layout.astro";

export const POSTS_PER_PAGE = 6;

export async function getStaticPaths() {
	const allPosts = await getCollection("post");

	let posts = allPosts.sort(
		(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
	);

	const featuredPost = posts.find((post) => post.data.featured);
	if (featuredPost) {
		posts = posts.filter((post) => post.data.featured !== true);
	}

	const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

	return Array.from({ length: totalPages }, (_, i) => {
		const page = i + 1;
		return {
			params: { page: page.toString() },
			props: { page: page.toString() },
		};
	});
}

const { page } = Astro.props;
const currentPage = Number.parseInt(page);
---

<Layout 
  title={`深度评测与专栏 (第 ${currentPage} 页) — ${siteConfig.title}`} 
  description={`汇集主流机场品牌的深度实测档案、晚高峰多探针测速分析、协议技术原理解析与防坑选购实操指南。（第 ${currentPage} 页）`}
>
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      title="深度评测专栏"
      description="基于三大运营商晚高峰物理机实测、流媒体与 ChatGPT 原生解锁验证的深度专栏与选购指南。"
    />
  </section>
  <section class="relative z-20 mx-auto my-12 lg:px-0">
    <div class="mt-12">
      <BlogSection
        title="全部评测文章"
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    </div>
  </section>
</Layout>
