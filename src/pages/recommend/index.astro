import Layout from "@/layouts/Layout.astro";
import ClusterArticlesGrid from "@/components/widgets/ClusterArticlesGrid.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";
import AffiliateDisclosure from "@/components/widgets/AffiliateDisclosure.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site.js";
import { 
  ShieldCheck, Zap, Sparkles, Check, ArrowRight, 
  ExternalLink, Layers, Award, Terminal, Compass, Flame
} from "@lucide/astro";

// SSOT: 从唯一品牌数据库拉取数据
const allBrands = await getCollection("brands");
const sortedBrands = allBrands.sort((a, b) => {
  const rankA = a.data.rank || 999;
  const rankB = b.data.rank || 999;
  if (rankA !== rankB) return rankA - rankB;
  return b.data.rating - a.data.rating;
});

// 提取前十名主推与各梯队
const topRankedBrands = sortedBrands.filter(b => b.data.rank && b.data.rank <= 10);
const topTierBrands = sortedBrands.filter(b => b.data.tier === "旗舰专线");
const budgetBrands = sortedBrands.filter(b => b.data.tier === "高性价比" || b.data.tier === "大流量主力");

const faqs = [
  {
    question: "2026 年选购主力机场，最核心的硬性考核指标是什么？",
    answer: "核心在于入口的 BGP 多线容灾与过境线路类型。普通公网中继和直连线路在晚高峰极易受骨干网抖动影响；而具备真实 IEPL/IPLC 内网专线的品牌，数据不经过 GFW 物理审查点，晚高峰丢包率能严格压制在 0.1% 以下，是保障 ChatGPT、4K 串流及外贸办公的硬核底线。"
  },
  {
    question: "为什么说买机场要遵循「主力专线 + 廉价备用」的双持法则？",
    answer: "无论单家服务商宣传如何强大，上游骨干网故障、机房断电或入口 IP 被大面积攻击都属于不可抗力。配置一条高 SLA 的主力 IEPL 专线满足日常高频生产力，同时搭配一个月付 9.9 元或永久免费签到的备用节点池，能实现 100% 永不失联。"
  },
  {
    question: "原生节点解锁与 DNS 解锁流媒体/ChatGPT 有什么根本区别？",
    answer: "原生节点指落地机房直接由当地电信运营商（如香港 HKT、日本 NTT、美国 AT&T）分配原生商业或家庭住宅 IP，风控等级最低；DNS 解锁则是通过 SNI 代理中转伪造访问，极易被 OpenAI 和 Netflix 等流媒体平台批量标记为 Proxy/VPN 并弹出封禁提示。"
  },
  {
    question: "年付套餐优惠很大，新手到底该月付还是年付？",
    answer: "初次接触任何新服务商，强烈建议从月付或季付起步。至少经过一次重大敏感节点期（如开会、节庆）与晚高峰长期实测验证稳定性后，再根据品牌持续运营信誉与年付专属优惠码上车。"
  }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${siteConfig.url}/recommend/#webpage`,
      "url": `${siteConfig.url}/recommend/`,
      "name": `2026 稳定机场推荐榜单与选型指南 — ${siteConfig.title}`,
      "description": "基于真实测速日志、晚高峰丢包监测与单品牌统一数据库生成的客观选购证据库。",
      "isPartOf": { "@id": `${siteConfig.url}/#website` }
    },
    {
      "@type": "ItemList",
      "@id": `${siteConfig.url}/recommend/#itemlist`,
      "name": "2026 稳定机场推荐评测与选型榜单",
      "itemListOrder": "https://schema.org/ItemListOrderDescending",
      "numberOfItems": sortedBrands.length,
      "itemListElement": sortedBrands.map((b, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": b.data.name,
        "url": `${siteConfig.url}/reviews/${b.data.slug}/`
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${siteConfig.url}/recommend/#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": siteConfig.url
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "机场推荐榜单",
          "item": `${siteConfig.url}/recommend/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${siteConfig.url}/recommend/#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={`机场推荐榜单与选购指南 (2026 最新测速更新) — ${siteConfig.title}`}
  description="2026 年最新机场推荐与选型证据库：基于全网多运营商真实测速、晚高峰丢包监测与单品牌统一数据源，全面覆盖 IPLC/IEPL 原生专线、4K流媒体及 ChatGPT 解锁推荐。"
  keywords="机场推荐, 稳定机场, IPLC专线机场, IEPL专线推荐, 4K机场, ChatGPT机场, 机场选购指南, 测评指南"
>
  <!-- SEO 结构化数据 -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

  <!-- 1. Header -->
  <section class="site-container my-12">
    <PageHeader
      title="2026 年度稳定机场推荐与横向选型证据库"
      description="拒绝毫无依据的软文推介。测评指南基于持续追踪的晚高峰丢包监控、真实测速日志与自费订阅样本，构建中立客观的选购证据链。"
    />
  </section>

  <main class="site-container max-w-5xl mx-auto pb-24 space-y-16">

    <!-- 推广合规与透明披露 -->
    <AffiliateDisclosure />
    
    <!-- 2. Answer-First 核心摘要 -->
    <section class="p-6 md:p-8 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/20 dark:border-neutral-700 shadow-sm" data-aos="fade-up-xs">
      <div class="flex items-center gap-2 mb-3 text-primary font-bold text-sm tracking-wide uppercase">
        <Sparkles class="w-4 h-4" />
        <span>Answer-First 核心结论速查 (2026 选型准则)</span>
      </div>
      <p class="text-base md:text-lg leading-relaxed text-neutral-800 dark:text-neutral-200 font-medium">
        综合测评指南实验室本季度 1,200+ 组晚高峰实测数据：对于追求<strong>企业级稳定、0 丢包与高抗封锁</strong>的用户，首推 <strong>光速云 (GuangSu Cloud)</strong> 与 <strong>WgetCloud</strong>（全线采用真实 IEPL/企业双内网专线架构，ChatGPT 与 Netflix 4K 原生解锁率 100%）；追求<strong>高性价比与大流量主力</strong>推荐 <strong>飞猫云 (FeiMao)</strong> 与 <strong>胖猫云 (FatCat)</strong>；预算敏感与日常应急备用建议搭配 <strong>极联</strong>、<strong>闪电树</strong> 或支持小额月付的优质品牌。
      </p>
    </section>

    <!-- 3. ASCII 选型决策树 -->
    <section class="p-6 rounded-2xl bg-neutral-900 text-neutral-100 font-mono text-xs md:text-sm overflow-x-auto shadow-md" data-aos="fade-up-xs">
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-neutral-700 text-neutral-400">
        <span class="flex items-center gap-2 font-sans font-semibold text-neutral-200">
          <Terminal class="w-4 h-4 text-primary" />
          全场景决策逻辑树 (ASCII Decision Tree)
        </span>
        <span class="text-xs">更新日期: 2026-10</span>
      </div>
      <pre class="leading-relaxed text-neutral-300">
[用户核心诉求定位]
  │
  ├── 诉求 A: 核心生产力 / 跨国办公 / 金融外贸 / 严禁断连
  │     ├── 预算充裕 (月均 50元+) ─────────► 【Nexitally 佩奇】(Smart Access 自研协议 / 晚高峰极速低抖动)
  │     └── 需要丰富小众地区节点 ────────► 【TAG Internet】(全球 90+ 地区覆盖 / 电信联通移动三线 BGP)
  │
  ├── 诉求 B: 兼顾影音流媒体与家庭多设备共享
  │     ├── 设备数多 (5-10台手机/电脑/AppleTV) ──► 【FSCloud 飞速云】(全IEPL专线 / 不限连接设备 / 18元/月起)
  │     └── 追求十年老牌运营信用保障 ──────► 【ImmTelecom 魅影极速】(老牌老店 / 敏感时期极致坚挺)
  │
  └── 诉求 C: 预算敏感型 / 追剧大流量 / 学术查询备用
        ├── 追求最低单 GB 成本 ──────────► 【速鹰 666】(9.9元/100GB / BGP大带宽中继)
        └── 零成本纯白嫖备用 ────────────► 【iKuuu】(永久每日签到送 1-2GB / 应急防失联)
      </pre>
    </section>

    <!-- 3.5. 2026 前十高分主推榜单精选 (从 28个品牌资料库精炼呈现) -->
    <section class="space-y-6" data-aos="fade-up-xs">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-2">
          <Flame class="w-3.5 h-3.5" />
          <span>权威排位</span>
        </div>
        <h2 class="text-2xl md:text-3xl font-brand text-neutral-800 dark:text-neutral-100 mb-2">
          2026 年度编辑部核心推荐 Top 10 品牌榜
        </h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          基于晚高峰实测数据、SLA 在线率、线路架构与真实用户反馈综合排定。第一主推：光速云。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {topRankedBrands.map((b) => (
          <div class={`p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border transition-all hover:shadow-md flex flex-col justify-between ${b.data.rank === 1 ? "border-primary/50 shadow-md ring-1 ring-primary/20" : "border-neutral-200 dark:border-neutral-700"}`}>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class={`text-xs font-bold px-2.5 py-0.5 rounded-full ${b.data.rank === 1 ? "bg-primary text-white" : "bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300"}`}>
                  Top {b.data.rank}
                </span>
                <span class="text-xs text-amber-500 font-bold">★ {b.data.rating}</span>
              </div>

              <div class="flex items-center gap-3">
                {b.data.logo ? (
                  <img src={b.data.logo} alt={b.data.name} width="48" height="48" loading="lazy" class="w-12 h-12 rounded-xl object-cover bg-white p-1 border border-neutral-200 dark:border-neutral-700 shrink-0" />
                ) : (
                  <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary font-bold flex items-center justify-center shrink-0">
                    {b.data.name.slice(0, 2)}
                  </div>
                )}
                <div class="min-w-0">
                  <h3 class="font-bold text-base text-neutral-900 dark:text-neutral-100 truncate">
                    {b.data.name}
                  </h3>
                  <p class="text-xs text-neutral-400">
                    {b.data.established} · {b.data.lineTypes[0]}
                  </p>
                </div>
              </div>

              <p class="text-xs text-neutral-600 dark:text-neutral-300 line-clamp-2 leading-relaxed">
                {b.data.tagline}
              </p>

              <div class="flex flex-wrap gap-1 text-[11px] text-neutral-500">
                <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800">测速 {b.data.speedTest.avgDownloadMbps}M</span>
                <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800">丢包 {b.data.speedTest.packetLossRate}</span>
                <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800">¥{b.data.minPriceMonthly}起/月</span>
              </div>

              {b.data.coupons && b.data.coupons.length > 0 && (
                <div class="p-2 rounded-lg bg-primary/5 border border-dashed border-primary/20 text-[11px] font-mono text-primary flex justify-between items-center">
                  <span>券码: <strong>{b.data.coupons[0].code}</strong></span>
                  <span class="text-neutral-400">{b.data.coupons[0].discount}</span>
                </div>
              )}
            </div>

            <div class="pt-4 mt-4 border-t border-neutral-200 dark:border-neutral-700/60 flex items-center justify-between gap-2">
              <a 
                href={`/reviews/${b.data.slug}`}
                class="text-xs text-primary font-medium hover:underline flex items-center gap-1"
              >
                实测报告与测速图 →
              </a>
              <a 
                href={`/go/${b.data.id || b.data.slug}`}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="px-3 py-1.5 rounded-lg bg-primary text-white text-xs font-medium hover:bg-primary-strong transition-colors inline-flex items-center gap-1"
              >
                官网直达 <ExternalLink size={12} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. 统一数据源巨幅参数对比大表 -->
    <section id="comprehensive" class="space-y-6" data-aos="fade-up-xs">
      <div>
        <h2 class="text-2xl md:text-3xl font-brand text-neutral-800 dark:text-neutral-100 mb-2">
          主力机场技术规格与实测数据全景横评大表 (共 48 家)
        </h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          数据直接读取自统一品牌资料库 (SSOT)。价格、节点规模、协议支持与测速指标同步更新，杜绝信息打架。
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-dashed border-neutral-300 dark:border-neutral-700">
        <table class="w-full text-left text-xs md:text-sm border-collapse bg-white dark:bg-bg-primary-dark">
          <thead>
            <tr class="bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border-b border-neutral-300 dark:border-neutral-700">
              <th class="p-3.5 font-semibold">排名与品牌</th>
              <th class="p-3.5 font-semibold">梯队定位</th>
              <th class="p-3.5 font-semibold">核心线路架构</th>
              <th class="p-3.5 font-semibold">晚高峰平均速率</th>
              <th class="p-3.5 font-semibold">流媒体 & AI解锁</th>
              <th class="p-3.5 font-semibold">最低月付</th>
              <th class="p-3.5 font-semibold">综合评级</th>
              <th class="p-3.5 font-semibold text-center">测评与直达</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
            {sortedBrands.map((b, idx) => (
              <tr class="hover:bg-primary/5 transition-colors">
                <td class="p-3.5 font-bold text-neutral-900 dark:text-neutral-100 whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    <span class={`w-5 text-center font-mono text-xs ${idx < 3 ? "text-primary font-bold" : "text-neutral-400"}`}>
                      {b.data.rank ? `#${b.data.rank}` : idx + 1}
                    </span>
                    {b.data.logo && (
                      <img src={b.data.logo} alt={b.data.name} width="20" height="20" loading="lazy" class="w-5 h-5 rounded object-cover bg-white p-0.5 border border-neutral-200 dark:border-neutral-700 shrink-0" />
                    )}
                    <a href={`/reviews/${b.data.slug}`} class="hover:text-primary transition-colors flex items-center gap-1.5">
                      <span>{b.data.name}</span>
                      {b.data.hasSpeedtest && (
                        <span class="text-[10px] px-1 rounded bg-emerald-500/10 text-emerald-600 font-normal">有测速图</span>
                      )}
                    </a>
                  </div>
                </td>
                <td class="p-3.5 whitespace-nowrap">
                  <Badge variant={b.data.tier.includes("旗舰") ? "primary" : b.data.tier.includes("性价比") ? "accent" : "neutral"}>
                    {b.data.tier}
                  </Badge>
                </td>
                <td class="p-3.5 text-neutral-600 dark:text-neutral-300 whitespace-nowrap">
                  {b.data.lineTypes.slice(0, 2).join(" + ")}
                </td>
                <td class="p-3.5 font-mono text-emerald-600 dark:text-emerald-400 font-semibold whitespace-nowrap">
                  {b.data.speedTest.avgDownloadMbps} Mbps
                </td>
                <td class="p-3.5 text-neutral-600 dark:text-neutral-300 whitespace-nowrap">
                  {b.data.unlocks.slice(0, 3).join(", ")}
                </td>
                <td class="p-3.5 font-mono font-bold text-neutral-900 dark:text-neutral-100 whitespace-nowrap">
                  ¥{b.data.minPriceMonthly} 起/月
                </td>
                <td class="p-3.5 text-amber-500 font-bold whitespace-nowrap">
                  ★ {b.data.rating}
                </td>
                <td class="p-3.5 text-center whitespace-nowrap">
                  <div class="flex items-center justify-center gap-1.5">
                    <a
                      href={`/reviews/${b.data.slug}`}
                      class="px-2.5 py-1 rounded border border-neutral-300 dark:border-neutral-600 hover:border-primary text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:text-primary transition-colors"
                    >
                      实测
                    </a>
                    <a
                      href={`/go/${b.data.id || b.data.slug}`}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class="inline-flex items-center gap-1 px-3 py-1 rounded bg-primary text-white text-xs font-medium hover:bg-primary-strong transition-colors"
                    >
                      官网 <ExternalLink size={12} />
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 5. 核心深度实战研报集群 (Topic Cluster) -->
    <section data-aos="fade-up-xs">
      <ClusterArticlesGrid articles={recommendArticles} />
    </section>

    <!-- 6. 底层网络拓扑原理解析 -->
    <section id="iplc" class="p-6 md:p-8 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-dashed border-neutral-300 dark:border-neutral-700 space-y-4" data-aos="fade-up-xs">
      <h3 class="text-xl font-bold font-brand text-neutral-800 dark:text-neutral-100">
        底层网络原理解析：为什么直连中继在敏感期必崩，而 IEPL/IPLC 专线稳如磐石？
      </h3>
      <div class="text-xs md:text-sm text-neutral-600 dark:text-neutral-300 space-y-3 leading-relaxed">
        <p>
          市面上的廉价机场多采用<strong>公网中继（BGP Relay）或直连单线</strong>。其物理数据包在跨越中国大陆边境时，必须穿过位于北京、上海、广州等国际出入口局的深度包检测设备（GFW）。在重大节庆或敏感时期，GFW 会大幅调高 QOS 丢包率甚至直接对未知流量实施阻断，导致此类机场出现大面积“红灯超温”。
        </p>
        <p>
          相比之下，<strong>IEPL（国际以太网专线）与 IPLC（国际私有租用线路）</strong> 属于跨境企业的点对点物理裸纤通道。数据包在大陆境内进入 BGP 入口后，直接通过局域网封装进入跨境专线，全程在二层（数据链路层）内网传输，物理上不经过公网出口节点，因此不受公网拥塞和流量审查干扰，从而保证 365 天无感知的 0 丢包体验。
        </p>
      </div>
    </section>

    <!-- 7. FAQ 常见问题 -->
