---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site.js";
import { 
  Award, ShieldCheck, Zap, ArrowRight, Gauge, Scale, 
  BookOpen, GraduationCap, Ticket, ExternalLink, Terminal, 
  Sparkles, Flame
} from "@lucide/astro";

// SSOT: 从统一品牌数据源读取
const allBrands = await getCollection("brands");
const sortedBrands = allBrands.sort((a, b) => {
  const rankA = a.data.rank || 999;
  const rankB = b.data.rank || 999;
  if (rankA !== rankB) return rankA - rankB;
  return b.data.rating - a.data.rating;
});

const featuredGuangsu = allBrands.find(b => b.data.slug === "guangsu") || sortedBrands[0];

// 9 大一级专题入口卡片数据
const navHubs = [
  {
    title: "机场推荐",
    url: "/recommend",
    icon: Award,
    badge: "综合精选",
    desc: "2026 年度综合推荐榜单、按人群与使用场景精细选型、主力专线与高防备用梯队。",
    tags: ["综合榜单", "场景推荐", "旗舰专线"]
  },
  {
    title: "免费机场",
    url: "/free",
    icon: Zap,
    badge: "零门槛",
    desc: "正规永久每日签到免费资源、官方试用通道、免费节点与客户端，低价平替方案。",
    tags: ["每日签到", "官方试用", "安全防坑"]
  },
  {
    title: "深度评测",
    url: "/reviews",
    icon: ShieldCheck,
    badge: "全维实测",
    desc: "单品牌全维实测档案、真实丢包与带宽压测、套餐真实权益、客户端安全与售后观察。",
    tags: ["单品牌档案", "晚高峰实测", "DNS防漏"]
  },
  {
    title: "测速实验室",
    url: "/speedtest",
    icon: Gauge,
    badge: "多探针",
    desc: "华东、华南、华北分布式探针晚高峰实测日志，三大运营商差异与历史波动记录。",
    tags: ["晚高峰21点", "三网横评", "抖动方差"]
  },
  {
    title: "机场对比",
    url: "/compare",
    icon: Scale,
    badge: "1v1决战",
    desc: "TAG vs Nexitally 顶峰对决、同价位性价比比拼、同流量档位深度横评与协议取舍。",
    tags: ["二选一", "同价位对比", "协议取舍"]
  },
  {
    title: "品牌百科",
    url: "/wiki",
    icon: BookOpen,
    badge: "单一事实源",
    desc: "品牌基础资料库、历史运营时间线、全球节点地区档案、套餐历史调价记录追踪。",
    tags: ["成立年份", "节点档案", "调价历史"]
  },
  {
    title: "选购教程",
    url: "/tutorials",
    icon: GraduationCap,
    badge: "知识大系",
    desc: "科学评价标准、手把手教你读懂真实测速图、IEPL/IPLC 底层原理解析与防坑算力。",
    tags: ["读懂测速图", "专线科普", "防坑指南"]
  },
  {
    title: "优惠码",
    url: "/coupons",
    icon: Ticket,
    badge: "实时有效",
    desc: "各大主流品牌官方最新折扣代码汇总、适用套餐门槛说明、大促日历与失效归档。",
    tags: ["专属折扣", "折上折", "实时验证"]
  }
];

const faqs = [
  {
    question: "测评指南的定位是什么？与普通导航博客有何根本不同？",
    answer: "测评指南坚持「单一数据源（SSOT）」与「证据库（Evidence Base）」定位。全站所有推荐榜单、单品牌评测、横向对比大表与百科档案均直接调用同一套结构化品牌数据库，价格、节点与测速数据实时同步，彻底杜绝普通推广博客常见的各页面信息自相矛盾、过时死链与虚假宣传。"
  },
  {
    question: "为什么说主力机场必须认准「真实 IEPL/IPLC 内网专线」？",
    answer: "公网中继和直连节点在晚高峰（20:00~23:00）必须经过海关国际出口审查点，受骨干网拥塞与 QOS 限制丢包率激增；而 IEPL/IPLC 走的是企业点对点物理裸缆内网，全程不过公网审查局，365天保持 0 丢包极速，是跨国会议、ChatGPT 与流媒体 4K 的核心保障。"
  },
  {
    question: "普通用户如何构建最稳妥的网络防失联组合？",
    answer: "强烈建议践行「主力专线 + 免费/超低价备用」双持策略：选择一家高 SLA 的 IEPL 专线机场（如 TAG、Nexitally、FSCloud）作为主力生产力工具；同时配置一个支持每日签到的免费账号（如 iKuuu）或月付 9.9 元的备用机场，即可实现全天候永不失联。"
  }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteConfig.url}/#website`,
      "url": siteConfig.url,
      "name": siteConfig.title,
      "description": siteConfig.meta.description,
      "inLanguage": "zh-CN"
    },
    {
      "@type": "FAQPage",
      "@id": `${siteConfig.url}/#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={`测评指南 (CepingZhinan) — 2026最新推荐42家机场品牌评测与横向选购证据库（持续更新......）`}
  description="测评指南（cepingzhinan.fun）：用单品牌资料库、全维套餐对比、晚高峰多探针实测记录和品牌历史更新构建的客观选购证据库，全面覆盖机场推荐、对比、百科与优惠码。"
  keywords="测评指南, 机场评测, 机场推荐, 稳定机场, IPLC专线, 免费机场, 机场对比, 机场优惠码, cepingzhinan"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

  <!-- 1. Hero 区域 -->
  <section class="site-container my-12 md:my-16">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/20 bg-primary/5 text-primary text-xs font-semibold" data-aos="fade-up-xs">
        <Sparkles class="w-3.5 h-3.5" />
        <span>基于单品牌统一数据源 (SSOT) 的客观选型证据库</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-brand font-bold text-neutral-900 dark:text-neutral-100 leading-tight" data-aos="fade-up-xs" data-aos-delay="100">
        2026最新推荐42家机场品牌评测与横向选购证据库（持续更新......）
      </h1>

      <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed" data-aos="fade-up-xs" data-aos-delay="200">
        拒绝软文营销与虚假跑分。测评指南用统一品牌资料库、全维套餐对比、晚高峰多探针实测日志与历史变更档案，为您构建真实、可验证、客观公正的科学选购决策支持。
      </p>

      <div class="flex flex-wrap justify-center gap-3 pt-2" data-aos="fade-up-xs" data-aos-delay="300">
        <Button url="/recommend" type="fill" className="px-6 py-2.5">
          查阅 2026 推荐榜单 <ArrowRight size={16} />
        </Button>
        <Button url="/speedtest" className="px-6 py-2.5">
          晚高峰测速实验室
        </Button>
      </div>
    </div>
  </section>

  <main class="site-container max-w-5xl mx-auto pb-24 space-y-20">

    <!-- 2. 八大核心一级专题入口网格 -->
    <section class="space-y-8" data-aos="fade-up-xs">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-brand text-neutral-800 dark:text-neutral-100 mb-2">
          八大核心一级专题知识图谱大系
        </h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          全方位覆盖不同搜索意图与决策环节，构筑蜂巢式深度内链网络。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {navHubs.map((hub) => (
          <a
            href={hub.url}
            class="group p-5 rounded-2xl border border-dashed border-primary/20 bg-bg-secondary dark:bg-bg-secondary-dark flex flex-col justify-between hover:border-primary hover:shadow-md transition-all duration-200"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                  <hub.icon class="w-5 h-5" />
                </div>
                <Badge variant="primary" size="sm">{hub.badge}</Badge>
              </div>

              <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100 group-hover:text-primary transition-colors mb-2">
                {hub.title}
              </h3>

              <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed line-clamp-3 mb-4">
                {hub.desc}
              </p>
            </div>

            <div class="pt-3 border-t border-dashed border-neutral-200 dark:border-neutral-700/60 flex items-center justify-between text-xs text-primary font-medium">
              <span>进入专题大系</span>
              <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 2.5. 编辑部年度主推黄金展位：光速云 (第一主推) -->
    {featuredGuangsu && (
      <section class="p-6 md:p-8 rounded-3xl bg-gradient-to-br from-primary/10 via-bg-secondary to-bg-secondary dark:from-primary/15 dark:via-bg-secondary-dark dark:to-bg-secondary-dark border-2 border-primary/30 shadow-lg relative overflow-hidden" data-aos="fade-up-xs">
        <div class="absolute -right-12 -top-12 w-48 h-48 bg-primary/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
          <div class="space-y-4 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary text-white text-xs font-bold shadow-sm">
                <Flame class="w-3.5 h-3.5 fill-current" />
                2026 编辑部年度第一主推
              </span>
              <Badge variant="primary">{featuredGuangsu.data.tier}</Badge>
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400">
                ★ {featuredGuangsu.data.rating} 满贯首选
              </span>
            </div>

            <div class="flex items-start gap-4">
              {featuredGuangsu.data.logo && (
                <img 
                  src={featuredGuangsu.data.logo} 
                  alt="光速云 Logo" 
                  width="64"
                  height="64"
                  loading="lazy"
                  class="w-16 h-16 rounded-2xl bg-white p-1 shadow-sm border border-neutral-200 dark:border-neutral-700 shrink-0" 
                />
              )}
              <div>
                <h3 class="text-2xl md:text-3xl font-brand font-bold text-neutral-900 dark:text-neutral-50 flex items-center gap-2">
                  {featuredGuangsu.data.name}
                  <span class="text-xs font-normal text-neutral-400">（2020年稳定运营 · IEPL+企业内网双专线）</span>
                </h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-300 mt-1 leading-relaxed">
                  {featuredGuangsu.data.tagline}。节点覆盖香港×20、台湾×5、日本×10、新加坡×10、美英法德等全球 88+ 地区。支持自研客户端与第三方订阅无缝导入。
                </p>
              </div>
            </div>

            <!-- 核心特色亮点 -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1 text-xs">
              <div class="p-2.5 rounded-xl bg-white/80 dark:bg-bg-primary-dark/80 border border-neutral-200 dark:border-neutral-700">
                <span class="text-neutral-400 block text-[11px]">实测单线程</span>
                <span class="font-bold font-mono text-primary text-sm">{featuredGuangsu.data.speedTest.avgDownloadMbps} Mbps</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white/80 dark:bg-bg-primary-dark/80 border border-neutral-200 dark:border-neutral-700">
                <span class="text-neutral-400 block text-[11px]">斯诺克147不限时</span>
                <span class="font-bold text-neutral-800 dark:text-neutral-200 text-sm">247GB 永久不过期</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white/80 dark:bg-bg-primary-dark/80 border border-neutral-200 dark:border-neutral-700">
                <span class="text-neutral-400 block text-[11px]">轻量年付门槛</span>
                <span class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">约 ¥8 起/月</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white/80 dark:bg-bg-primary-dark/80 border border-neutral-200 dark:border-neutral-700">
                <span class="text-neutral-400 block text-[11px]">专属优惠码</span>
                <span class="font-bold font-mono text-primary text-sm">AMM (立减折算)</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0">
            <a 
              href="/go/guangsu"
              target="_blank"
              rel="nofollow sponsored noopener"
              class="px-6 py-3.5 rounded-xl bg-primary text-white font-bold text-center shadow-md hover:bg-primary-strong transition-all inline-flex items-center justify-center gap-2"
            >
              前往光速云官网直达
              <ExternalLink class="w-4 h-4" />
            </a>
            <a 
              href={`/reviews/${featuredGuangsu.data.slug}`}
              class="px-6 py-2.5 rounded-xl border border-primary/30 hover:border-primary text-primary dark:text-primary-light font-medium text-center transition-colors text-xs"
            >
              查看光速云完整测速图与解锁评测 →
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- 3. SSOT 核心品牌实时对比矩阵大表 -->
    <section class="space-y-6" data-aos="fade-up-xs">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl md:text-3xl font-brand text-neutral-800 dark:text-neutral-100 mb-2">
            核心收录品牌技术参数全景横向大表 (SSOT)
          </h2>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">
            全站数据唯一来源。推荐页、对比页、评测页从同一份数据读取价格和测速，杜绝矛盾。
          </p>
        </div>
        <a href="/compare" class="text-xs text-primary font-semibold hover:underline flex items-center gap-1 whitespace-nowrap">
          查看完整 1v1 对比中心 →
        </a>
      </div>

      <div class="overflow-x-auto rounded-xl border border-dashed border-neutral-300 dark:border-neutral-700">
        <table class="w-full text-left text-xs md:text-sm border-collapse bg-white dark:bg-bg-primary-dark">
          <thead>
            <tr class="bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border-b border-neutral-300 dark:border-neutral-700">
              <th class="p-3.5 font-semibold">排名与品牌</th>
              <th class="p-3.5 font-semibold">定位梯队</th>
              <th class="p-3.5 font-semibold">核心线路架构</th>
              <th class="p-3.5 font-semibold">晚高峰单线程实测</th>
              <th class="p-3.5 font-semibold">流媒体与AI解锁</th>
              <th class="p-3.5 font-semibold">最低门槛</th>
              <th class="p-3.5 font-semibold">综合评级</th>
              <th class="p-3.5 font-semibold text-center">测评与直达</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
            {sortedBrands.map((b, idx) => (
              <tr class="hover:bg-primary/5 transition-colors">
                <td class="p-3.5 font-bold text-neutral-900 dark:text-neutral-100 whitespace-nowrap">
                  <div class="flex items-center gap-2.5">
                    <span class={`w-5 text-center font-mono text-xs ${idx < 3 ? "text-primary font-bold" : "text-neutral-400"}`}>
                      {b.data.rank ? `#${b.data.rank}` : idx + 1}
                    </span>
                    {b.data.logo && (
                      <img src={b.data.logo} alt={b.data.name} width="24" height="24" loading="lazy" class="w-6 h-6 rounded-md object-cover bg-white p-0.5 border border-neutral-200 dark:border-neutral-700 shrink-0" />
                    )}
                    <a href={`/reviews/${b.data.slug}`} class="hover:text-primary transition-colors flex items-center gap-1.5">
                      <span>{b.data.name}</span>
                      {b.data.hasSpeedtest && (
                        <span class="text-[10px] px-1 rounded bg-emerald-500/10 text-emerald-600 font-normal">有测速图</span>
                      )}
                    </a>
                  </div>
                </td>
                <td class="p-3.5 whitespace-nowrap">
                  <Badge variant={b.data.tier.includes("旗舰") ? "primary" : b.data.tier.includes("性价比") ? "accent" : "neutral"}>
                    {b.data.tier}
                  </Badge>
                </td>
                <td class="p-3.5 text-neutral-600 dark:text-neutral-300 whitespace-nowrap">
                  {b.data.lineTypes[0]}
                </td>
                <td class="p-3.5 font-mono text-emerald-600 dark:text-emerald-400 font-bold whitespace-nowrap">
                  {b.data.speedTest.avgDownloadMbps} Mbps
                </td>
                <td class="p-3.5 text-neutral-600 dark:text-neutral-300 whitespace-nowrap">
                  {b.data.unlocks.slice(0, 3).join(", ")}
                </td>
                <td class="p-3.5 font-mono font-bold text-neutral-900 dark:text-neutral-100 whitespace-nowrap">
                  ¥{b.data.minPriceMonthly} 起/月
                </td>
                <td class="p-3.5 text-amber-500 font-bold whitespace-nowrap">
                  ★ {b.data.rating}
                </td>
                <td class="p-3.5 text-center whitespace-nowrap">
                  <div class="flex items-center justify-center gap-1.5">
                    <a
                      href={`/reviews/${b.data.slug}`}
                      class="px-2.5 py-1 rounded border border-neutral-300 dark:border-neutral-600 hover:border-primary text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:text-primary transition-colors"
                    >
                      实测
                    </a>
                    <a
                      href={`/go/${b.data.id || b.data.slug}`}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class="inline-flex items-center gap-1 px-3 py-1 rounded bg-primary text-white text-xs font-medium hover:bg-primary-strong transition-colors"
                    >
                      官网 <ExternalLink size={11} />
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4. 内链主线闭环流程图 (Topic Cluster Pipeline) -->
    <section class="p-6 md:p-8 rounded-2xl bg-neutral-900 text-neutral-100 font-mono text-xs md:text-sm overflow-x-auto shadow-md" data-aos="fade-up-xs">
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-neutral-700 text-neutral-400">
        <span class="flex items-center gap-2 font-sans font-semibold text-neutral-200">
          <Terminal class="w-4 h-4 text-primary" />
          全站内链主线闭环决策流 (Internal Linking Pipeline)
        </span>
        <span class="text-xs">闭环转化证据链</span>
      </div>
      <pre class="leading-relaxed text-neutral-300">
【第一站: 机场推荐】──► 筛选符合场景的 2~3 个候选品牌 (旗舰 / 性价比 / 备用)
          │
          ▼
【第二站: 机场对比】──► 进入 1v1 深度参数对决，权衡晚高峰丢包、设备限制与每GB成本
          │
          ▼
【第三站: 单品牌评测】──► 查阅真实多探针测速图、全平台客户端体验与 DNS 防泄漏日志
          │
          ▼
【第四站: 品牌百科】──► 调取成立年份、运营时间线与历史套餐调价记录，排除跑路风险
          │
          ▼
