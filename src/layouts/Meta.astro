---
import { siteConfig } from "@/config/site.js";

export interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	url?: string;
	ogImage?: string;
	twitterHandle?: string;
	ogType?: string;
	publishedTime?: string | Date | undefined;
	modifiedTime?: string | Date | undefined;
	author?: string | undefined;
	category?: string | undefined;
	tags?: string[] | undefined;
}

const {
	title,
	description,
	keywords = siteConfig.meta.keywords,
	url,
	ogImage = siteConfig.meta.image,
	twitterHandle = siteConfig.meta.twitterHandle,
	ogType = "website",
	publishedTime,
	modifiedTime,
	author = siteConfig.author,
	category,
	tags,
} = Astro.props;

const pageTitle = title
	? title.includes(siteConfig.title)
		? title
		: `${title} | ${siteConfig.title}`
	: siteConfig.meta.title;
const pageDescription = description || siteConfig.meta.description;
const canonicalURL = url
	? url.startsWith("http")
		? url
		: new URL(url, siteConfig.url).href
	: new URL(Astro.url.pathname, siteConfig.url).href;
const fullOgImage = ogImage.startsWith("http")
	? ogImage
	: new URL(ogImage, siteConfig.url).href;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteConfig.url}/#website`,
			url: siteConfig.url,
			name: siteConfig.title,
			description: siteConfig.meta.description,
			inLanguage: "zh-CN",
		},
		{
			"@type": "Organization",
			"@id": `${siteConfig.url}/#organization`,
			name: siteConfig.title,
			url: siteConfig.url,
			logo: {
				"@type": "ImageObject",
				url: `${siteConfig.url}/assets/logo.png`,
			},
			email: siteConfig.mail,
		},
	],
};
---

<!-- Basic Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="keywords" content={keywords} />
<meta name="author" content={siteConfig.author} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" href="/favicon.png" />

<!-- Search Engine Verification Meta Tags (Direct HTML Output) -->
{siteConfig.verification?.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
{siteConfig.verification?.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
{siteConfig.verification?.shenma && <meta name="shenma-site-verification" content={siteConfig.verification.shenma} />}
{siteConfig.verification?.baidu && <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />}

<!-- Open Graph Tags -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content="zh_CN" />
{ogType === "article" && publishedTime && (
  <meta property="article:published_time" content={typeof publishedTime === "string" ? publishedTime : publishedTime.toISOString()} />
)}
{ogType === "article" && modifiedTime && (
  <meta property="article:modified_time" content={typeof modifiedTime === "string" ? modifiedTime : modifiedTime.toISOString()} />
)}
{ogType === "article" && author && (
  <meta property="article:author" content={author} />
)}
{ogType === "article" && category && (
  <meta property="article:section" content={category} />
)}
{ogType === "article" && tags && tags.map((t: string) => (
  <meta property="article:tag" content={t} />
))}

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={fullOgImage} />
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
{twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

<!-- Structured Data (JSON-LD) for SEO -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
